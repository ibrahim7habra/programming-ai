name: Daily News Updater

on:
  schedule:
    - cron: "0 7 * * *" # يعمل يومياً الساعة 07:00 UTC
  workflow_dispatch: # يتيح لك تشغيله يدوياً من تبويب Actions

jobs:
  update-news:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Fetch daily news
        env:
          NEWS_API_KEY: ${{ secrets.NEWS_API_KEY }}
        run: node scripts/fetch-daily-news.js

      - name: Commit and push daily news
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data/daily-news.json
          git diff --staged --quiet || git commit -m "chore: update daily news"
          git push
